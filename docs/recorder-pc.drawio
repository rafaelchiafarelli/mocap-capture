120" width="200" height="62" as="geometry"/></mxCell><mxCell id="d19" value="&lt;b&gt;2 take-integration&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;needs recording/3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="750" y="192" width="200" height="62" as="geometry"/></mxCell><mxCell id="d20" value="&lt;b&gt;verification&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="980" y="80" width="220" height="30" as="geometry"/></mxCell><mxCell id="d21" value="&lt;b&gt;1 takereport&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;needs recording/4, sync/2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="990" y="120" width="200" height="62" as="geometry"/></mxCell><mxCell id="d22" value="&lt;b&gt;preprocess&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1220" y="80" width="220" height="30" as="geometry"/></mxCell><mxCell id="d23" value="&lt;b&gt;1 preprocess-config&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;PreprocessSpec | none&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1230" y="120" width="200" height="62" as="geometry"/></mxCell><mxCell id="d24" value="&lt;b&gt;2 preprocess-run&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;decide: output codec (FFV1?)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1230" y="192" width="200" height="62" as="geometry"/></mxCell><mxCell id="d25" value="&lt;b&gt;handoff&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1460" y="80" width="220" height="30" as="geometry"/></mxCell><mxCell id="d26" value="&lt;b&gt;1 event-publisher&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;sidecar first, then PUSH&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1470" y="120" width="200" height="62" as="geometry"/></mxCell><mxCell id="d27" value="&lt;b&gt;2 file-transfer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;decide: SSH target into WSL2 / network&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1470" y="192" width="200" height="62" as="geometry"/></mxCell><mxCell id="d28" value="&lt;b&gt;3 handoff-flow&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;decide: are raw/ videos sent?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1470" y="264" width="200" height="62" as="geometry"/></mxCell><mxCell id="d29" value="&lt;b&gt;Start here&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;branch chain for the first task:&lt;br&gt;dev → features → baseline → epics&lt;br&gt;&amp;nbsp;&amp;nbsp;→ bootstrap → tasks&lt;br&gt;&amp;nbsp;&amp;nbsp;→ 1-skeleton-and-cli&lt;br&gt;needs: mocap-contracts v0.2.1 ✓&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="220" height="120" as="geometry"/></mxCell><mxCell id="d30" value="&lt;b&gt;studio-setup&lt;/b&gt; (P1) — parts need the baseline's STREAM source and Rafael's decisions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="820" height="20" as="geometry"/></mxCell><mxCell id="d31" value="&lt;b&gt;procedure&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="220" height="30" as="geometry"/></mxCell><mxCell id="d32" value="&lt;b&gt;1 setup-checklist&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;docs only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="30" y="570" width="200" height="62" as="geometry"/></mxCell><mxCell id="d33" value="&lt;b&gt;board&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="260" y="530" width="220" height="30" as="geometry"/></mxCell><mxCell id="d34" value="&lt;b&gt;1 board-declaration&lt;/b&gt;&lt;br&gt;&lt;font styl