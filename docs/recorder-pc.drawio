<mxfile host="mocap-studio"><diagram id="a" name="1 · Components"><mxGraphModel dx="1720" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a2" value="&lt;b style='font-size:18px'&gt;Recorder PC — mocap-capture components&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color='#666666'&gt;what runs on the recorder, which task builds each part · stages P1 + P2 of docs/diagrams/pipeline.drawio&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1680" height="40" as="geometry"/></mxCell><mxCell id="a3" value="Cameras + operator" style="swimlane;html=1;startSize=28;rounded=1;arcSize=2;fontSize=13;fontStyle=1;swimlaneFillColor=none;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="250" height="600" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;UVC webcam&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;USB&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;V4L2 device /dev/videoN&lt;br&gt;MJPG at a declared size/fps&lt;br&gt;controls: V4L2 (v4l2-ctl)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="a3"><mxGeometry x="15" y="40" width="220" height="110" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;STREAM camera&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;Wi-Fi&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;tablet/phone running &lt;b&gt;mocap-camera-app&lt;/b&gt;&lt;br&gt;stream protocol v1:&lt;br&gt;· &lt;b&gt;video_port&lt;/b&gt; TCP: GET /h264.raw →&lt;br&gt;&amp;nbsp;&amp;nbsp;H.264 Annex-B, one SEI per frame&lt;br&gt;&amp;nbsp;&amp;nbsp;(seq, sensor_ns capture time)&lt;br&gt;· &lt;b&gt;sync_port&lt;/b&gt; UDP: clock probes&lt;br&gt;camera.harpia over ZeroMQ:&lt;br&gt;· ControlRequest (app binds PULL)&lt;br&gt;· ControlReply → recorder (recorder binds)&lt;br&gt;· CameraStats (app binds PUB)&lt;br&gt;ports declared in config.yaml, never discovered&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="a3"><mxGeometry x="15" y="170" width="220" height="250" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;Operator / director&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;runs the CLI in a terminal&lt;br&gt;watches the live monitor&lt;br&gt;follows docs/setup-checklist.md&lt;br&gt;(studio-setup procedure/1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="a3"><mxGeometry x="15" y="440" width="220" height="140" as="geometry"/></mxCell><mxCell id="a7" value="Recorder PC — Linux (development: WSL2, see page 3) · package mocap_capture" style="swimlane;html=1;startSize=28;rounded=1;arcSize=2;fontSize=13;fontStyle=1;swimlaneFillColor=none;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="1060" height="890" as="geometry"/></mxCell><mxCell id="a8" value="&lt;b&gt;CLI + config&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;baseline bootstrap/1&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;mocap-capture&lt;/b&gt; take · send · camera controls|set|save · board pdf · calibration check · monitor · --version&lt;br&gt;&lt;b&gt;load_config(config.yaml)&lt;/b&gt; → CameraConfig per role (source UVC|STREAM, serial/bus_path, ports, format) · PreprocessSpec or &lt;i&gt;none&lt;/i&gt; per role · board · controls · handoff target. Everything is declared; nothing is guessed or defaulted.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a7"><mxGeometry x="20" y="40" width="1020" height="70" as="geometry"/></mxCell><mxCell id="a9" value="&lt;b&gt;CameraSource protocol&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;devices/1&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;prepare() · start(take) · stop() · collect(take_dir) — registry keyed by source type. Everything above this line never knows which camera type it talks to.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a7"><mxGeometry x="20" y="135" width="600" height="50" as="geometry"/></mxCell><mxCell id="a10" value="&lt;b&gt;UvcSource&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;devices/2–4 · recording/1, 2, 4&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;list_uvc_devices() → path, name, serial, bus_path&lt;br&gt;probe_formats / select_format(w, h, fps, MJPG)&lt;br&gt;resolve_roles: serial, then bus_path; missing = error&lt;br&gt;one &lt;b&gt;ffmpeg&lt;/b&gt; per camera: -f v4l2 -input_format mjpeg&lt;br&gt;&amp;nbsp;&amp;nbsp;-c:v copy → MKV, wall-clock timestamps&lt;br&gt;supervisor: stop with 'q', detects crashes&lt;br&gt;ffprobe -show_frames → raw/&amp;lt;role&amp;gt;.timestamps.csv&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a7"><mxGeometry x="20" y="205" width="290" height="165" as="geometry"/></mxCell><mxCell id="a11" value="&lt;b&gt;StreamSource&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;devices/5&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;prepare(): connect + clock sync #1 (UDP probes)&lt;br&gt;start(): GET /h264.raw, write as-is (no re-encode)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ raw/&amp;lt;role&amp;gt;.mkv&lt;br&gt;stop(): clock sync #2&lt;br&gt;host_ts_ns = sensor_ns + offset, interpolated&lt;br&gt;&amp;nbsp;&amp;nbsp;between the two syncs (removes ~20 ppm drift)&lt;br&gt;a jump in SEI seq = a gap, always reported&lt;br&gt;uses mocap_contracts.stream_v1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a7"><mxGeometry x="330" y="205" width="290" height="165" as="geometry"/></mxCell><mxCell id="a12" value="&lt;b&gt;Camera controls&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;studio-setup cameras/2–4&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;UvcControls&lt;/b&gt;: v4l2-ctl --list-ctrls-menus / --get-ctrl / --set-ctrl&lt;br&gt;&lt;b&gt;StreamControls&lt;/b&gt;: ControlRequest → ControlReply over ZeroMQ&lt;br&gt;one vocabulary: ControlCapability · ControlSetting · ControlResult&lt;br&gt;&lt;b&gt;every&lt;/b&gt; control the device offers, native key names&lt;br&gt;every value read back: applied / clamped / unsupported /&lt;br&gt;&amp;nbsp;&amp;nbsp;read-only / failed — never silently ignored&lt;br&gt;camera controls|set|save (save writes config.yaml controls:)&lt;br&gt;before every take: declared controls applied + read back;&lt;br&gt;&amp;nbsp;&amp;nbsp;a failure refuses the take&lt;br&gt;→ take.json: control_results + applied_controls per role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="a7"><mxGeometry x="640" y="135" width="400" height="235" as="geometry"/></mxCell><mxCell id="a13" value="&lt;b&gt;Take lifecycle&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;recording/3 · sync/1–2&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;mocap-capture take --session S --name N --type PERFORMANCE|CALIBRATION&lt;br&gt;1. resolve roles, apply controls, prepare every source&lt;br&gt;2. all ready? → start all → &lt;b&gt;START&lt;/b&gt; SyncEvent&lt;br&gt;3. … recording (one file per camera) …&lt;br&gt;4. &lt;b&gt;END&lt;/b&gt; SyncEvent → stop all → collect&lt;br&gt;5. write take.json (sync events, controls, preprocess)&lt;br&gt;SyncEvent = ManualTrigger.mark(), host clock in ns&lt;br&gt;page 2 shows the full sequence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a7"><mxGeometry x="20" y="390" width="330" height="160" as="geometry"/></mxCell><mxCell id="a14" value="&lt;b&gt;Take report&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;verification/1&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;per camera: frames, measured fps,&lt;br&gt;fps variation, gaps &amp;gt; 1.5 periods&lt;br&gt;START/END inside every camera's&lt;br&gt;timestamp range&lt;br&gt;→ report.json (TakeReport)&lt;br&gt;+ terminal summary, ok=false&lt;br&gt;when something is wrong&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a7"><mxGeometry x="370" y="390" width="210" height="160" as="geometry"/></mxCell><mxCell id="a15" value="&lt;b&gt;Preprocess (per role)&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;preprocess/1–2&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;after the take, CPU only,&lt;br&gt;no neural nets&lt;br&gt;FFmpeg crop / scale&lt;br&gt;one output frame per input frame&lt;br&gt;&lt;i&gt;none&lt;/i&gt; = stream copy&lt;br&gt;→ prep/&amp;lt;role&amp;gt;.mkv&lt;br&gt;&lt;font color='#b85450'&gt;output codec: open (FFV1?)&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a7"><mxGeometry x="600" y="390" width="210" height="160" as="geometry"/></mxCell><mxCell id="a16" value="&lt;b&gt;Hand-off&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;handoff/1–3&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;send_file&lt;/b&gt;: rsync over SSH,&lt;br&gt;temp name → rename, resumable&lt;br&gt;&lt;b&gt;publish(event)&lt;/b&gt;: sidecar JSON&lt;br&gt;first, then ZeroMQ PUSH&lt;br&gt;per file, as soon as it is ready&lt;br&gt;mocap-capture send = idempotent&lt;br&gt;resend of anything missing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a7"><mxGeometry x="830" y="390" width="210" height="160" as="geometry"/></mxCell><mxCell id="a17" value="&lt;b&gt;Live monitor&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;live-monitor initiative&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;PreviewTap&lt;/b&gt;: one slot per role holding only the latest frame + host_ts_ns;&lt;br&gt;&amp;nbsp;&amp;nbsp;writers overwrite, readers never block recording&lt;br&gt;UVC: a 2nd low-res output of the same ffmpeg process (recording stays -c:v copy)&lt;br&gt;STREAM: decode on a separate thread as frames arrive, drop if behind&lt;br&gt;&lt;b&gt;mocap-capture monitor&lt;/b&gt;: every role, stale cameras flagged, overlays&lt;br&gt;&amp;nbsp;&amp;nbsp;(role, take state, frame age, fps/drops)&lt;br&gt;&lt;font color='#b85450'&gt;open: where it is shown, layout, latency target, overlay list&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="a7"><mxGeometry x="20" y="570" width="500" height="150" as="geometry"/></mxCell><mxCell id="a18" value="&lt;b&gt;Studio setup (P1)&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;studio-setup initiative&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;setup checklist → docs/setup-checklist.md (procedure/1)&lt;br&gt;ChArUco board declared in config.yaml board: (no defaults) → &lt;b&gt;board pdf&lt;/b&gt; at 1:1,&lt;br&gt;&amp;nbsp;&amp;nbsp;then measured with a caliper (board/1–2)&lt;br&gt;camera placement plan, manual (cameras/1)&lt;br&gt;guided calibration take: board detection on &lt;b&gt;preview&lt;/b&gt; frames, coverage live&lt;br&gt;ground-plane take · &lt;b&gt;calibration check&lt;/b&gt;: runs mocap-extract's CLI → PASS/FAIL&lt;br&gt;&lt;font color='#b85450'&gt;open: board, capture volume, face/hand mounting, where the check runs&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="a7"><mxGeometry x="540" y="570" width="500" height="150" as="geometry"/></mxCell><mxCell id="a19" value="&lt;b&gt;Session folder on disk&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;mocap_contracts.layout — identical on both PCs&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&amp;lt;root&amp;gt;/&amp;lt;session&amp;gt;/&lt;b&gt;session.json&lt;/b&gt; (actors, characters, board) · calibration/&lt;br&gt;&amp;lt;root&amp;gt;/&amp;lt;session&amp;gt;/takes/&amp;lt;take&amp;gt;/&lt;b&gt;take.json&lt;/b&gt; · &lt;b&gt;report.json&lt;/b&gt; · &lt;b&gt;closed.json&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;raw/&amp;lt;role&amp;gt;.mkv + raw/&amp;lt;role&amp;gt;.timestamps.csv (frame, host_ts_ns) &amp;nbsp;·&amp;nbsp; prep/&amp;lt;role&amp;gt;.mkv &amp;nbsp;·&amp;nbsp; &amp;lt;file&amp;gt;.ready.json next to each sent file&lt;br&gt;The folder is the record, the events are only the nudge. raw/ videos stay on the recorder as the archive &lt;font color='#b85450'&gt;(proposal, open)&lt;/font&gt;; timestamps always travel.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="a7"><mxGeometry x="20" y="740" width="1020" height="130" as="geometry"/></mxCell><mxCell id="a20" value="&lt;b&gt;mocap-contracts&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;pip dependency, pinned v0.2.1 — the only shared code&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Harpia-generated messages: CameraConfig, Take, SyncEvent, TakeReport, PreprocessSpec, CalibrationBoard, ControlCapability/Setting/Result, DeviceInfo, CameraStats, TakeClosed, CameraFileReady&lt;br&gt;layout (session folder paths) · stream_v1 (reference reader + fixtures) · transport (ZeroMQ push/pull, pub/sub). mocap-capture never imports another mocap-* repository.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="970" width="1060" height="90" as="geometry"/></mxCell><mxCell id="a21" value="Processing PC — Windows + WSL2" style="swimlane;html=1;startSize=28;rounded=1;arcSize=2;fontSize=13;fontStyle=1;swimlaneFillColor=none;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1400" y="60" width="300" height="330" as="geometry"/></mxCell><mxCell id="a22" value="&lt;b&gt;mocap-extract watch&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;receives TakeClosed / CameraFileReady&lt;br&gt;verifies each file against its sidecar&lt;br&gt;&amp;nbsp;&amp;nbsp;(size, sha256, frames)&lt;br&gt;rescans sidecars after a restart&lt;br&gt;starts each P3 step when its inputs are in&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="a21"><mxGeometry x="15" y="40" width="270" height="140" as="geometry"/></mxCell><mxCell id="a23" value="&lt;b&gt;Session folder&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;same layout&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;filled file by file by the hand-off&lt;br&gt;+ extract/ · adapt/ · blender/&lt;br&gt;P3 alignment, calibration, FreeMoCap&lt;br&gt;(all neural nets live here)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="a21"><mxGeometry x="15" y="195" width="270" height="115" as="geometry"/></mxCell><mxCell id="a24" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="420" width="280" height="20" as="geometry"/></mxCell><mxCell id="a25" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1400" y="444" width="22" height="18" as="geometry"/></mxCell><mxCell id="a26" value="baseline initiative" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="444" width="250" height="20" as="geometry"/></mxCell><mxCell id="a27" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1400" y="470" width="22" height="18" as="geometry"/></mxCell><mxCell id="a28" value="studio-setup initiative (P1)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="470" width="250" height="20" as="geometry"/></mxCell><mxCell id="a29" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1400" y="496" width="22" height="18" as="geometry"/></mxCell><mxCell id="a30" value="live-monitor initiative" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="496" width="250" height="20" as="geometry"/></mxCell><mxCell id="a31" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1400" y="522" width="22" height="18" as="geometry"/></mxCell><mxCell id="a32" value="mocap-contracts (library)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="522" width="250" height="20" as="geometry"/></mxCell><mxCell id="a33" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1400" y="548" width="22" height="18" as="geometry"/></mxCell><mxCell id="a34" value="outside this repo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="548" width="250" height="20" as="geometry"/></mxCell><mxCell id="a35" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1400" y="574" width="22" height="18" as="geometry"/></mxCell><mxCell id="a36" value="needs a fixture / setup step" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="574" width="250" height="20" as="geometry"/></mxCell><mxCell id="a37" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1400" y="600" width="22" height="18" as="geometry"/></mxCell><mxCell id="a38" value="open decision or known risk" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="600" width="250" height="20" as="geometry"/></mxCell><mxCell id="a39" value="&lt;b&gt;Reading this page&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Each box is a part of mocap-capture; the grey tag is the task (initiatives/&amp;lt;initiative&amp;gt;/epics/&amp;lt;epic&amp;gt;/tasks/) that builds it. Unprefixed tags are the &lt;b&gt;baseline&lt;/b&gt; initiative.&lt;br&gt;&lt;br&gt;Camera types only meet the rest of the code through &lt;b&gt;CameraSource&lt;/b&gt;, so a camera can be swapped later without touching recording, report, preprocess or hand-off.&lt;br&gt;&lt;br&gt;Every frame of every camera ends up on one clock: the recorder's host clock (host_ts_ns). That is the whole sync strategy of the baseline; no sync hardware.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1400" y="630" width="300" height="300" as="geometry"/></mxCell><mxCell id="a40" value="USB / V4L2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="a4" target="a10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a41" value="Wi-Fi: HTTP video + UDP sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.45;entryX=0.5;entryY=0;" edge="1" parent="1" source="a5" target="a11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="255"/><mxPoint x="775" y="255"/></Array></mxGeometry></mxCell><mxCell id="a42" value="ZeroMQ control · info · stats" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;exitX=1;exitY=0.15;entryX=0.5;entryY=0;" edge="1" parent="1" source="a5" target="a12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="185"/><mxPoint x="1140" y="185"/></Array></mxGeometry></mxCell><mxCell id="a43" value="commands" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="a6" target="a8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="285" y="542"/><mxPoint x="285" y="135"/></Array></mxGeometry></mxCell><mxCell id="a44" value="rsync over SSH (wired LAN)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="a16" target="a22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a45" value="ZeroMQ PUSH: TakeClosed · CameraFileReady" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;dashed=1;exitX=1;exitY=0.7;entryX=0;entryY=0.8;" edge="1" parent="1" source="a16" target="a22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="b" name="2 · One take"><mxGraphModel dx="1720" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b2" value="&lt;b style='font-size:18px'&gt;One take, start to finish&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color='#666666'&gt;who does what, in order · hand-off is per file, never a take-level gate&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1680" height="40" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Before START&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="52" width="330" height="22" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;Recording&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="52" width="260" height="22" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;At END&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="52" width="360" height="22" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;After END — each role on its own&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="52" width="510" height="22" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;Operator&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="150" height="110" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;mocap-capture&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="150" height="270" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;Cameras&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="150" height="120" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;Session folder&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="150" height="120" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;Processing PC&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="150" height="140" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;1. Start the take&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;mocap-capture take --session S --name N&lt;br&gt;&amp;nbsp;&amp;nbsp;--type PERFORMANCE | CALIBRATION&lt;br&gt;(CALIBRATION: board copied into take.json;&lt;br&gt;&amp;nbsp;--guided shows board coverage live)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="180" y="80" width="330" height="110" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;Actors perform&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;director watches the live monitor&lt;br&gt;(preview path, never slows recording)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="530" y="80" width="260" height="110" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;4. Stop the take&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;operator ends it (key press)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="810" y="80" width="360" height="110" as="geometry"/></mxCell><mxCell id="b15" value="&lt;b&gt;Read the summary&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;terminal summary of report.json: fps, gaps, sync markers inside every range&lt;br&gt;mocap-capture send --session S --take T resends anything missing (safe to rerun)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1190" y="80" width="510" height="110" as="geometry"/></mxCell><mxCell id="b16" value="&lt;b&gt;2. Prepare&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;recording/3&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;load config.yaml, check ids&lt;br&gt;resolve roles → devices (serial, then bus_path)&lt;br&gt;apply + read back each role's declared controls;&lt;br&gt;&amp;nbsp;&amp;nbsp;any failure → the take refuses to start&lt;br&gt;UVC: select the declared format&lt;br&gt;STREAM: connect, &lt;b&gt;clock sync #1&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(UDP probes, fastest 10%, median offset)&lt;br&gt;every source ready? otherwise stop here&lt;br&gt;create takes/&amp;lt;take&amp;gt;/ via layout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="180" y="200" width="330" height="270" as="geometry"/></mxCell><mxCell id="b17" value="&lt;b&gt;3. Record&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;recording/2 · devices/5 · sync/2&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;start every source&lt;br&gt;→ &lt;b&gt;START&lt;/b&gt; SyncEvent once all started&lt;br&gt;UVC: ffmpeg -c:v copy → raw/&amp;lt;role&amp;gt;.mkv&lt;br&gt;STREAM: H.264 written as it arrives&lt;br&gt;&amp;nbsp;&amp;nbsp;→ raw/&amp;lt;role&amp;gt;.mkv&lt;br&gt;supervisor watches for crashes;&lt;br&gt;dropped connections become gaps&lt;br&gt;preview tap feeds the monitor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="530" y="200" width="260" height="270" as="geometry"/></mxCell><mxCell id="b18" value="&lt;b&gt;5. Close&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;sync/2 · recording/4 · devices/5 · handoff/3&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;END&lt;/b&gt; SyncEvent → stop every source&lt;br&gt;STREAM: &lt;b&gt;clock sync #2&lt;/b&gt; → offset + drift&lt;br&gt;write raw/&amp;lt;role&amp;gt;.timestamps.csv for every role&lt;br&gt;&amp;nbsp;&amp;nbsp;(UVC via ffprobe, STREAM via SEI + sync)&lt;br&gt;write take.json: sync events, control_results,&lt;br&gt;&amp;nbsp;&amp;nbsp;applied_controls&lt;br&gt;&lt;b&gt;hand-off, step 1&lt;/b&gt;: send session.json, take.json,&lt;br&gt;&amp;nbsp;&amp;nbsp;each timestamps file (+ CameraFileReady TIMESTAMPS)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ publish &lt;b&gt;TakeClosed&lt;/b&gt;&lt;br&gt;TakeClosed means all of these have arrived&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="810" y="200" width="360" height="270" as="geometry"/></mxCell><mxCell id="b19" value="&lt;b&gt;6. role body_1&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;preprocess/2 · handoff/3&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;preprocess → prep/body_1.mkv → rsync → &lt;b&gt;CameraFileReady&lt;/b&gt; (VIDEO)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1190" y="200" width="340" height="54" as="geometry"/></mxCell><mxCell id="b20" value="&lt;b&gt;6. role body_2&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;preprocess/2 · handoff/3&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;preprocess → prep/body_2.mkv → rsync → &lt;b&gt;CameraFileReady&lt;/b&gt; (VIDEO)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1190" y="262" width="340" height="54" as="geometry"/></mxCell><mxCell id="b21" value="&lt;b&gt;6. role face&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;preprocess/2 · handoff/3&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;preprocess → prep/face.mkv → rsync → &lt;b&gt;CameraFileReady&lt;/b&gt; (VIDEO)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1190" y="324" width="340" height="54" as="geometry"/></mxCell><mxCell id="b22" value="&lt;font style='font-size:10px'&gt;… one row per role, in parallel. A fast camera never waits for a slow one.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="388" width="340" height="30" as="geometry"/></mxCell><mxCell id="b23" value="&lt;b&gt;7. Report&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;verification/1&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;report.json&lt;br&gt;(TakeReport)&lt;br&gt;&lt;br&gt;sent when ready;&lt;br&gt;it never gates&lt;br&gt;processing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1545" y="200" width="155" height="270" as="geometry"/></mxCell><mxCell id="b24" value="&lt;font style='font-size:10px'&gt;UVC: device opened at the declared format&lt;br&gt;STREAM: app answers the clock probes;&lt;br&gt;its ZeroMQ endpoint answered the control requests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="180" y="480" width="330" height="120" as="geometry"/></mxCell><mxCell id="b25" value="&lt;font style='font-size:10px'&gt;UVC: MJPG frames over USB&lt;br&gt;STREAM: H.264 + SEI capture time&lt;br&gt;over Wi-Fi (~20 Mbps each)&lt;br&gt;CameraStats published every second&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="530" y="480" width="260" height="120" as="geometry"/></mxCell><mxCell id="b26" value="&lt;font style='font-size:10px'&gt;STREAM: answers the second clock sync&lt;br&gt;then idles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="810" y="480" width="360" height="120" as="geometry"/></mxCell><mxCell id="b27" value="&lt;font style='font-size:10px'&gt;idle until the next take&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1190" y="480" width="510" height="120" as="geometry"/></mxCell><mxCell id="b28" value="&lt;font style='font-size:10px'&gt;takes/&amp;lt;take&amp;gt;/ created&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="180" y="610" width="330" height="120" as="geometry"/></mxCell><mxCell id="b29" value="&lt;font style='font-size:10px'&gt;raw/&amp;lt;role&amp;gt;.mkv growing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="530" y="610" width="260" height="120" as="geometry"/></mxCell><mxCell id="b30" value="&lt;font style='font-size:10px'&gt;take.json&lt;br&gt;raw/&amp;lt;role&amp;gt;.timestamps.csv&lt;br&gt;closed.json (the TakeClosed sidecar)&lt;br&gt;&amp;lt;file&amp;gt;.ready.json for each sent file&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="810" y="610" width="360" height="120" as="geometry"/></mxCell><mxCell id="b31" value="&lt;font style='font-size:10px'&gt;prep/&amp;lt;role&amp;gt;.mkv + prep/&amp;lt;role&amp;gt;.mkv.ready.json&lt;br&gt;report.json&lt;br&gt;raw/&amp;lt;role&amp;gt;.mkv stays here as the archive (proposal, open)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1190" y="610" width="510" height="120" as="geometry"/></mxCell><mxCell id="b32" value="&lt;font style='font-size:10px'&gt;nothing yet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="180" y="740" width="330" height="140" as="geometry"/></mxCell><mxCell id="b33" value="&lt;font style='font-size:10px'&gt;nothing yet&lt;br&gt;(live forwarding of frames is phase 2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="530" y="740" width="260" height="140" as="geometry"/></mxCell><mxCell id="b34" value="&lt;b&gt;mocap-extract watch&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;TakeClosed → session.json, take.json and&lt;br&gt;every timestamps file are there&lt;br&gt;→ alignment plan can be computed right away&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="810" y="740" width="360" height="140" as="geometry"/></mxCell><mxCell id="b35" value="&lt;b&gt;mocap-extract watch&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;each CameraFileReady → verify size + sha256 + frames against the sidecar&lt;br&gt;→ resample + 2D for that camera as soon as its video is in&lt;br&gt;lost event? the sidecars are rescanned after any restart&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1190" y="740" width="510" height="140" as="geometry"/></mxCell><mxCell id="b36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="b12" target="b16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="b16" target="b17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="b14" target="b18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1" source="b17" target="b18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="c" name="3 · Dev setup (WSL2)"><mxGraphModel dx="1720" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:18px'&gt;Running the recorder in WSL2 for now&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color='#666666'&gt;the target is a native Linux PC; this is how the same code runs on the Windows machine during development · checked 2026-10-05&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1680" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Windows host" style="swimlane;html=1;startSize=28;rounded=1;arcSize=2;fontSize=13;fontStyle=1;swimlaneFillColor=none;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1240" height="860" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;usbipd-win&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;Windows, admin · DEPENDENCIES.md&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;winget install usbipd&lt;br&gt;usbipd list → find the webcam's busid&lt;br&gt;usbipd bind --busid &amp;lt;id&amp;gt; &amp;nbsp;(once)&lt;br&gt;usbipd attach --wsl --busid &amp;lt;id&amp;gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;(again after every replug or WSL restart)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c3"><mxGeometry x="20" y="45" width="360" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Network adapters&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Wi-Fi → the capture access point (tablets)&lt;br&gt;wired LAN → processing PC (hand-off)&lt;br&gt;&lt;font color='#b85450'&gt;if this machine IS the processing PC, the hand-off target&lt;/font&gt;&lt;br&gt;&lt;font color='#b85450'&gt;is local during development — declare it in handoff:&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="c3"><mxGeometry x="20" y="190" width="360" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;%UserProfile%\.wslconfig&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;not present today → WSL runs in &lt;b&gt;NAT&lt;/b&gt; mode&lt;br&gt;option: [wsl2] networkingMode=mirrored&lt;br&gt;(+ Hyper-V firewall rules for inbound ports)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c3"><mxGeometry x="20" y="325" width="360" height="105" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Windows Python&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;only for camera-stream-eval measurements,&lt;br&gt;which are taken from Windows on purpose&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="c3"><mxGeometry x="20" y="445" width="360" height="90" as="geometry"/></mxCell><mxCell id="c8" value="WSL2 · Ubuntu · kernel 6.18 microsoft-standard" style="swimlane;html=1;startSize=28;rounded=1;arcSize=2;fontSize=13;fontStyle=1;swimlaneFillColor=none;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="410" y="45" width="810" height="790" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;USB video&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;kernel: CONFIG_USB_VIDEO_CLASS=m, CONFIG_VIDEO_DEV=m ✓&lt;br&gt;&amp;nbsp;&amp;nbsp;(uvcvideo is available as a module)&lt;br&gt;/dev/videoN appears after usbipd attach&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;font color='#b85450'&gt;none today: nothing attached&lt;/font&gt;&lt;br&gt;MJPG through usbip can be bandwidth-limited:&lt;br&gt;&amp;nbsp;&amp;nbsp;verify real fps with the take report&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c8"><mxGeometry x="20" y="45" width="380" height="150" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Tools&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ffmpeg, ffprobe, rsync ✓&lt;br&gt;python3 3.12 ✓&lt;br&gt;&lt;b&gt;v4l2-ctl ✗&lt;/b&gt; → sudo apt install v4l-utils&lt;br&gt;&amp;nbsp;&amp;nbsp;(devices/2–3 and controls need it)&lt;br&gt;venv: pip install -e . with&lt;br&gt;&amp;nbsp;&amp;nbsp;mocap-contracts[zmq] @ git+…@v0.2.1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c8"><mxGeometry x="410" y="45" width="380" height="150" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;mocap-capture&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;this repository&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;same code as on the Linux recorder: nothing WSL-specific goes into the package. Device paths, hosts and ports are all declared in a config.yaml for this machine.&lt;br&gt;pytest runs entirely on fakes and fixtures — no camera, tablet or second PC needed for the suite to be green.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c8"><mxGeometry x="20" y="210" width="770" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Network today: NAT&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;eth0 172.29.x.x/20&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;outbound works&lt;/b&gt; (WSL opens the connection):&lt;br&gt;· GET /h264.raw to each tablet&lt;br&gt;· UDP clock probes to each tablet&lt;br&gt;· ControlRequest PUSH to each app&lt;br&gt;· CameraStats SUB to each app&lt;br&gt;· rsync over SSH + event PUSH to the processing PC&lt;br&gt;&lt;b&gt;inbound does not&lt;/b&gt; without extra setup:&lt;br&gt;· ControlReply: each app connects &lt;i&gt;into&lt;/i&gt; the&lt;br&gt;&amp;nbsp;&amp;nbsp;recorder's bound receiver → needs mirrored&lt;br&gt;&amp;nbsp;&amp;nbsp;mode or a netsh portproxy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c8"><mxGeometry x="20" y="325" width="380" height="230" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Known risk: TCP stalls under NAT&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;measured 2026-10-04&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;tablet-stream-test / camera-stream-eval: inside WSL2 NAT,&lt;br&gt;TCP streams stall ~3 s every ~35 s — it looks like frame&lt;br&gt;loss but it is the VM's network, not the tablet.&lt;br&gt;&lt;br&gt;Options (Rafael's call, before the devices/5 live check):&lt;br&gt;a) mirrored networking — &lt;b&gt;not measured yet&lt;/b&gt;: re-run&lt;br&gt;&amp;nbsp;&amp;nbsp;camera-stream-eval from inside WSL with it on&lt;br&gt;b) develop in WSL on fixtures; record real takes&lt;br&gt;&amp;nbsp;&amp;nbsp;only on native Linux&lt;br&gt;c) both: try a), fall back to b)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c8"><mxGeometry x="410" y="325" width="380" height="230" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;What needs what&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;Nothing but WSL + Python&lt;/b&gt; (fakes / fixtures from mocap-contracts): bootstrap/1 · devices/1, 4, 5 (code) · recording/1–3 · sync/1–2 · verification/1 · preprocess/1 · handoff/1 · live-monitor preview-tap/1 · studio-setup procedure/1&lt;br&gt;&lt;br&gt;&lt;b&gt;A webcam attached through usbipd + v4l-utils&lt;/b&gt; (one-off fixtures, saved to tests/fixtures/): devices/2 (v4l2-ctl --list-devices) · devices/3 (--list-formats-ext) · recording/4 (short recording) · cameras/2 (--list-ctrls-menus)&lt;br&gt;&lt;br&gt;&lt;b&gt;A tablet running the app, plus the network question above&lt;/b&gt;: the live check of devices/5 · cameras/3 against a real app · live-monitor latency&lt;br&gt;&lt;br&gt;&lt;b&gt;Two machines (or a declared local target)&lt;/b&gt;: the handoff/2 real transfer · the baseline initiative gate (1 webcam + ≥2 tablets, every file arrives, announced by its event)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="c8"><mxGeometry x="20" y="570" width="770" height="200" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;USB webcam&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;plugged into Windows&lt;br&gt;→ usbipd → WSL /dev/videoN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1290" y="60" width="400" height="120" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Tablets on the capture Wi-Fi&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;mocap-camera-app (or camera-stream-eval app)&lt;br&gt;video_port 8080 TCP · sync_port 8081 UDP&lt;br&gt;+ ZeroMQ control / stats ports (declared)&lt;br&gt;4 × 20 Mbps measured fine on one 2.4 GHz AP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1290" y="200" width="400" height="140" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Processing PC&lt;/b&gt; &amp;nbsp;&lt;font color='#666666' style='font-size:10px'&gt;Windows + WSL2, RTX 4080&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;accepting rsync over SSH + ZeroMQ into WSL2&lt;br&gt;behind NAT is still open (Windows OpenSSH&lt;br&gt;or a port forward) — HANDOFF.md Q3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1290" y="360" width="400" height="110" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="500" width="400" height="20" as="geometry"/></mxCell><mxCell id="c19" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1290" y="524" width="22" height="18" as="geometry"/></mxCell><mxCell id="c20" value="baseline initiative" style="text;html=1;whiteSpace=wrap;a