era-app control&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="510" y="714" width="200" height="62" as="geometry"/></mxCell><mxCell id="d40" value="&lt;b&gt;4 controls-cli-and-take&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;camera controls|set|save&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="510" y="786" width="200" height="62" as="geometry"/></mxCell><mxCell id="d41" value="&lt;b&gt;calibration-take&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="740" y="530" width="220" height="30" as="geometry"/></mxCell><mxCell id="d42" value="&lt;b&gt;1 guided-calibration-take&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;decide: face/hand mounting; needs preview-tap/1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="750" y="570" width="200" height="62" as="geometry"/></mxCell><mxCell id="d43" value="&lt;b&gt;2 ground-plane-take&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="750" y="642" width="200" height="62" as="geometry"/></mxCell><mxCell id="d44" value="&lt;b&gt;calibration-check&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="980" y="530" width="220" height="30" as="geometry"/></mxCell><mxCell id="d45" value="&lt;b&gt;1 quick-calibration-check&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;decide: where it runs, threshold; needs mocap-extract&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="990" y="570" width="200" height="62" as="geometry"/></mxCell><mxCell id="d46" value="&lt;b&gt;live-monitor&lt;/b&gt; — blocked on its 4 open decisions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="500" width="480" height="20" as="geometry"/></mxCell><mxCell id="d47" value="&lt;b&gt;preview-tap&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1220" y="530" width="220" height="30" as="geometry"/></mxCell><mxCell id="d48" value="&lt;b&gt;1 previewtap-interface&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ready&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1230" y="570" width="200" height="62" as="geometry"/></mxCell><mxCell id="d49" value="&lt;b&gt;2 uvc-preview-tap&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;needs recording/2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1230" y="642" width="200" height="62" as="geometry"/></mxCell><mxCell id="d50" value="&lt;b&gt;3 stream-preview-tap&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;needs devices/5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1230" y="714" width="200" height="62" as="geometry"/></mxCell><mxCell id="d51" value="&lt;b&gt;viewer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1460" y="530" width="220" height="30" as="geometry"/></mxCell><mxCell id="d52" value="&lt;b&gt;1 camera-grid&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;decide: where, layout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1470" y="570" width="200" height="62" as="geometry"/></mxCell><mxCell id="d53" value="&lt;b&gt;2 overlays&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;decide: overlay list&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1470" y="642" width="200" height="62" as="geometry"/></mxCell><mxCell id="d54" value="&lt;b&gt;latency&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1220" y="800" width="460" height="30" as="geometry"/></mxCell><mxCell id="d55" value="&lt;b&gt;1 frame-age-measurement&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;decide: latency target&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1230" y="840" width="200" height="62" as="geometry"/></mxCell><mxCell id="d56" value="&lt;b&gt;2 recording-isolation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;initiative gate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1470" y="840" width="200" height="62" as="geometry"/></mxCell><mxCell id="d57" value="&lt;b&gt;Gates&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;b&gt;baseline&lt;/b&gt;: one take with 1 webcam + ≥2 streaming tablets → valid take.json and report.json, START/END inside every camera's range, every file intact on the processing PC, each announced by its CameraFileReady.&lt;br&gt;&lt;b&gt;studio-setup&lt;/b&gt;: from an empty room, the checklist gives a declared board, locked controls in take.json and a calibration that passes the quick check — before the first performance take.&lt;br&gt;&lt;b&gt;live-monitor&lt;/b&gt;: every camera shown with p95 frame age ≤ target, and recorded files identical to a take without the viewer.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="700" height="150" as="geometry"/></mxCell><mxCell id="d58" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="880" width="300" height="20" as="geometry"/></mxCell><mxCell id="d59" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="740" y="904" width="22" height="18" as="geometry"/></mxCell><mxCell id="d60" value="baseline initiative" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="904" width="270" height="20" as="geometry"/></mxCell><mxCell id="d61" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="740" y="930" width="22" height="18" as="geometry"/></mxCell><mxCell id="d62" value="studio-setup initiative (P1)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="930" width="270" height="20" as="geometry"/></mxCell><mxCell id="d63" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="740" y="956" width="22" height="18" as="geometry"/></mxCell><mxCell id="d64" value="live-monitor initiative" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="956" width="270" height="20" as="geometry"/></mxCell><mxCell id="d65" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="740" y="982" width="22" height="18" as="geometry"/></mxCell><mxCell id="d66" value="mocap-contracts (library)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="982" width="270" height="20" as="geometry"/></mxCell><mxCell id="d67" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="740" y="1008" width="22" height="18" as="geometry"/></mxCell><mxCell id="d68" value="outside this repo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="1008" width="270" height="20" as="geometry"/></mxCell><mxCell id="d69" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="740" y="1034" width="22" height="18" as="geometry"/></mxCell><mxCell id="d70" value="needs a fixture / setup step" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="1034" width="270" height="20" as="geometry"/></mxCell><mxCell id="d71" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="740" y="1060" width="22" height="18" as="geometry"/></mxCell><mxCell id="d72" value="open decision or known risk" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="1060" width="270" height="20" as="geometry"/></mxCell><mxCell id="d73" value="&lt;font style='font-size:10px'&gt;&lt;b&gt;Colours on this page&lt;/b&gt; mean readiness, not only initiative: a red task cannot start until Rafael answers the decision written in it (HANDOFF.md &quot;Ask Rafael before implementing&quot; and the Open decisions in studio-setup.md / live-monitor.md). An orange task needs a one-off fixture captured from the real device first — that is pre-work, saved into tests/fixtures/, never part of the implementation. Every other task can be done entirely on fakes.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="880" width="640" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
